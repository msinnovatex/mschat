# MS Chat environment template. Add real values in Vercel Project Settings -> Environment Variables.
# Never commit .env or expose server secrets through VITE_ variables.

NODE_ENV=development
APP_BASE_URL=http://localhost:5173
# Comma-separated exact origins, e.g. https://your-domain.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
SESSION_TTL_SECONDS=2592000
# Server-only HMAC secret for OTP digests (generate at least 32 random bytes).
OTP_HMAC_SECRET=REPLACE_WITH_64_HEX_CHARACTERS

# Firebase Admin SDK; all app data is stored below the mschat/ RTDB root.
FIREBASE_DATABASE_URL=https://YOUR_FIREBASE_PROJECT-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_SERVICE_ACCOUNT_EMAIL
# Replace escaped \n with the service account private key, preserving newline escaping.
FIREBASE_PRIVATE_KEY=REPLACE_WITH_REAL_PRIVATE_KEY

# Gmail API OAuth credentials. OAuth refresh token must have gmail.send scope.
GMAIL_CLIENT_ID=REPLACE_LATER
GMAIL_CLIENT_SECRET=REPLACE_LATER
GMAIL_REFRESH_TOKEN=REPLACE_LATER
GMAIL_SENDER_EMAIL=REPLACE_LATER

# Cloudflare R2 credentials. Keep the bucket private; object keys use mschat/attachments/.
R2_ACCOUNT_ID=REPLACE_LATER
R2_ACCESS_KEY_ID=REPLACE_LATER
R2_SECRET_ACCESS_KEY=REPLACE_LATER
R2_BUCKET_NAME=REPLACE_LATER

# Web Push. Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=REPLACE_LATER
VAPID_PRIVATE_KEY=REPLACE_LATER
VAPID_SUBJECT=mailto:admin@example.com

# One-time admin bootstrap. Set ADMIN_EMAIL to the verified email of the account that should be admin.
# Set a long random secret, use it once at /admin, then remove/rotate it after bootstrap.
ADMIN_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Vercel Cron authentication for scheduled cleanup.
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
